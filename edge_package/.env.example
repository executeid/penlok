# ==============================================================================
# PENLOK SMART LOCKER - DEVICE EDGE ENVIRONMENT CONFIGURATION (TEMPLATE)
# Salin file ini menjadi .env dan sesuaikan nilai konfigurasi.
# Node Target: pi@10.1.1.224:2523 (Raspberry Pi 5)
# ==============================================================================

# Timezone
TZ=Asia/Jakarta

# Target Cloud GPU Node (pengmas-tri)
CLOUD_HOST=10.1.1.186
CLOUD_PORT=9000
CLOUD_HOST_FALLBACK=100.76.68.93

# Target Edge Brain Scheduler (edge-penlok)
SCHEDULER_HOST=10.1.1.57
SCHEDULER_PORT=8500

# Edge Local Services
EDGE_GATEWAY_PORT=8600
SYNC_SECRET=change_me_to_secure_secret

# Local PostgreSQL Database
DB_HOST=host.docker.internal
DB_PORT=1723
DB_USER=smartlocker_admin
DB_PASSWORD=change_me_to_db_password
DB_NAME=smartlocker

# Local SQLite Offline Buffer Path
SQLITE_BUFFER_PATH=/home/pi/penlock/data/edge_decision_buffer.db
