# Deploy using dependencies already verified on the cloud, without downloading
# a second CUDA stack. Tag the verified local image ID and pass that tag as
# BASE_IMAGE (BuildKit does not accept a bare sha256 image ID in FROM).
ARG BASE_IMAGE=cloud-face-agent:latest
FROM ${BASE_IMAGE}
WORKDIR /home/penlok/app
COPY main.py cloud_app_main_full.py ./
ENV PYTHONUNBUFFERED=1 REQUIRE_GPU=1
EXPOSE 9000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9000"]
